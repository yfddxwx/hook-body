<Window x:Class="AuthIsland.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权胶囊" Width="480" Height="392"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="True">

    <Border x:Name="Shell" Margin="18" CornerRadius="22" Background="#0D0E13"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="30,24,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 拖拽区 + 关闭 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="AUTH ISLAND" FontSize="10" Foreground="#5C5C6B"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CloseButton" Text="✕" FontSize="12" Foreground="#6E6E7E"
                           HorizontalAlignment="Right" Cursor="Hand"
                           MouseLeftButtonUp="OnClose"
                           Padding="6,2" />
            </Grid>

            <!-- 标题 -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="把授权弹窗，变成顶部的一个胶囊"
                           FontSize="19" FontWeight="SemiBold" Foreground="#F4F4FA"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#8E8E9C" TextWrapping="Wrap"
                           LineHeight="19"
                           Text="Agent 需要授权时，胶囊会从屏幕顶部浮现，写着它想做什么、为什么要问你。点一下就行。" />
            </StackPanel>

            <!-- 三个要点 -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <TextBlock Text="✓" Foreground="#4ADE80" FontSize="12" Width="20" />
                    <TextBlock Text="不用装 Python、Node 或任何运行库" FontSize="12" Foreground="#B9B9C6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <TextBlock Text="✓" Foreground="#4ADE80" FontSize="12" Width="20" />
                    <TextBlock Text="自动写 WorkBuddy 配置，装完就能用" FontSize="12" Foreground="#B9B9C6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="#4ADE80" FontSize="12" Width="20" />
                    <TextBlock Text="日常命令静默放行，只有超权操作才打扰你" FontSize="12" Foreground="#B9B9C6" />
                </StackPanel>
            </StackPanel>

            <!-- 状态 -->
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,18,0,0"
                       FontSize="11.5" Foreground="#6E6E7E" TextWrapping="Wrap"
                       LineHeight="18" Text="" />

            <!-- 主按钮 -->
            <Border x:Name="ActionButton" Grid.Row="4" Height="44" CornerRadius="22"
                    Background="#F4F4FA" Cursor="Hand" MouseLeftButtonUp="OnAction">
                <TextBlock x:Name="ActionText" Text="一键安装" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#0B0B10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="5" Margin="0,12,0,0" FontSize="10.5" Foreground="#4E4E5C"
                       HorizontalAlignment="Center"
                       Text="装到当前用户目录，不需要管理员权限 · 可随时卸载" />
        </Grid>
    </Border>
</Window>
