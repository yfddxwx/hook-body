<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AuthIsland</AssemblyName>
    <RootNamespace>AuthIsland</RootNamespace>
    <!-- 自己写 Main：钩子模式要能在不加载 WPF 的前提下直接退出，
         否则每次工具调用都要背上整套 UI 程序集的启动开销 -->
    <StartupObject>AuthIsland.Program</StartupObject>
    <Version>1.0.0</Version>
    <Product>AuthIsland</Product>
    <Description>Dynamic-Island style authorization capsule for AI agents on Windows.</Description>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF 靠 app.manifest 声明 PerMonitorV2；WinForms SDK 会建议改用 API，这里保持 manifest -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- UseWindowsForms 会偷偷注入 System.Windows.Forms / System.Drawing 的全局 using，
       这会让 WPF 里的 Application / Brush 变成二义性引用。只保留 WPF 的命名空间。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
